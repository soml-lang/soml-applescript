#!/bin/bash
set -euo pipefail

if [[ $# != 1 || ! $1 =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
	printf '%s\n' 'Usage: ./release 0.0.1' >&2
	exit 1
fi

cd -- "$(dirname -- "$0")"

if [[ $(git branch --show-current) != main || -n $(git status --porcelain) ]]; then
	printf '%s\n' 'Release requires a clean working tree on main.' >&2
	exit 1
fi

gh auth status
plutil -replace CFBundleShortVersionString -string "$1" source/Info.plist
git add source/Info.plist
git commit -m "$1"
git push origin main
gh workflow run release.yml --ref main
